def StopAnimation(): void
    if anim_timer != -1
        timer_stop(anim_timer)
        anim_timer = -1
    endif
enddef

def UpdateLoader(timer: number): void
    if start_bufnr == -1 || bufnr('') != start_bufnr || !bufexists(start_bufnr)
        StopAnimation()
        return
    endif

    anim_idx = (anim_idx + 1) % len(anim_frames)
    var bar = anim_frames[anim_idx]
    var line_str = repeat(' ', loader_pad) .. bar

    setlocal modifiable
    setline(loader_line_nr, line_str)
    setlocal nomodifiable nomodified
enddef

def CustomStartScreen(forced = false): void
    if !forced
        if argc() > 0 || line2byte('$') != -1 || &insertmode || expand('%') !=# ''
            return
        endif
    endif

    StopAnimation()

    enew
    start_bufnr = bufnr('')

    setlocal bufhidden=wipe buftype=nofile nobuflisted nolist noswapfile
    setlocal nocursorcolumn nocursorline nonumber norelativenumber
    setlocal colorcolumn= signcolumn=no nomodifiable

    var hour = str2nr(strftime('%H'))
    var greeting = ''
    if hour >= 5 && hour < 12
        greeting = 'good morning · sacred path awaits'
    elseif hour >= 12 && hour < 18
        greeting = 'good afternoon · gravity pulls forward'
    elseif hour >= 18 && hour < 22
        greeting = 'good evening · peace in the orbit'
    else
        greeting = 'midnight session · silent void'
    endif

    var hud = [
        '     ╦  ╦ ╔═╗ ╦ ╠═╗ *',
        '  *  ╚╗╔╝ ║ ║ ║ ║ ║',
        '      ╚╝  ╚═╝ ╩ ╠═╝',
        '',
        '  ── EVENT HORIZON ──',
        '     (SINGULARITY)',
        '',
        '',
        '     ► [e]  NEW SESSION',
        '',
        '     ► [r]  RECENT FILES',
        '',
        '     ► [o]  EXPLORE TREE',
        '',
        '     ► [q]  QUIT SESSION',
        '',
        '',
        '',
        $'    ~ {greeting} ~',
        '',
        '',
        '',
        '',
        '',
        '            c³ kᵦ A',
        '    Sᵦₕ  = ──────────',
        '            4 G ℏ',
        ''
    ]

    var max_hud_width = max(mapnew(hud, (_, v) => strdisplaywidth(v)))
    var hud_column_width = max([max_hud_width + 8, 44])

    var final_lines: list<string> = []
    var total_rows = max([len(hud), len(black_hole)])

    for i in range(total_rows)
        var hud_text   = (i < len(hud)) ? hud[i] : ''
        var pad_needed = max([0, hud_column_width - strdisplaywidth(hud_text)])
        var left_part  = hud_text .. repeat(' ', pad_needed)

        var raw_art    = (i < len(black_hole)) ? substitute(black_hole[i], '[\u2800 ]\+$', '', '') : ''

        add(final_lines, left_part .. raw_art)
    endfor

    var win_height = winheight(0)
    var win_width  = winwidth(0)
    var art_width  = max(mapnew(final_lines, (_, v) => strdisplaywidth(v)))
    var pad_left   = max([0, (win_width - art_width) / 2])

    anim_idx = 0
    var initial_loader = anim_frames[0]
    var loader_full = repeat(' ', hud_column_width + 24) .. initial_loader
    add(final_lines, loader_full)

    add(final_lines, '')
    add(final_lines, repeat(' ', hud_column_width + 17) .. 'VIM - Vi IMproved 9.2')

    var padded_content = mapnew(final_lines, (_, v) => repeat(' ', pad_left) .. v)
    var pad_top = max([0, (win_height - len(padded_content)) / 2 - 1])
    var final_screen = repeat([''], pad_top) + padded_content

    loader_line_nr = pad_top + (total_rows + 1)
    loader_pad = pad_left + hud_column_width + 24

    setlocal modifiable
    setline(1, final_screen)
    setlocal nomodifiable nomodified

    ApplySolixHighlights()
    syntax clear

    syntax match BHFine             /[\u2801-\u28FF]/ contains=BHCore,BHDense,BHMid
    syntax match BHMid              /[⠶⠷⠸⠹⠺⠻⠼⠽⠾⠿⡿⣟⣯⢟⣮⣭⣵⣠⣤]/ contains=BHCore,BHDense
    syntax match BHDense            /[⣶⣷⣾⢿]/ contains=BHCore
    syntax match BHCore             /[⣿]/

    syntax match SolixLogo          /[╔═╗╚╦╩║╬╝⁺╠]/
    syntax match SolixSub           /EVENT\s\+HORIZON/
    syntax match SolixSing          /SINGULARITY/
    syntax match GameArrow          /►/
    syntax match GameKey            /\[\zs\k\ze\]/
    syntax match GameLabel          /\(► \[.\].*\)/ contains=GameKey,GameArrow
    syntax match GameQuote          /\~.*\~/
    syntax match GameFormulaBar     /─\+/
    syntax match GameFormula        /\v(c³ kᵦ A|Sᵦₕ\s*\=\s*─+|4 G ℏ)/ contains=GameFormulaBar
    syntax match GameVersion        /VIM - Vi IMproved 9\.2/

    syntax match AnimPeak           /■/ contained
    syntax match AnimMid            /◼/ contained
    syntax match AnimLow            /▪/ contained
    syntax match AnimBar            /^\s*\%([■◼▪]\s*\)\+$/ contains=AnimPeak,AnimMid,AnimLow

    syntax match TeleIcons          /[⌬⌖·]/ contained
    syntax match TeleLab            /KAL-LAB-007\|CORE\.007/ contained
    syntax match TeleAuthor         /@God311_/ contained
    syntax match GameTelemetry      /.*KAL-LAB-007.*/ contains=TeleIcons,TeleLab,TeleAuthor,TeleBase

    if has('timers')
        anim_timer = timer_start(120, UpdateLoader, {repeat: -1})
    endif

    nnoremap <buffer><silent><nowait> e :enew<CR>
    nnoremap <buffer><silent><nowait> r :browse oldfiles<CR>
    nnoremap <buffer><silent><nowait> o :NERDTreeFocus<CR>
    nnoremap <buffer><silent><nowait> q :quit<CR>

    nnoremap <buffer><silent> i <Nop>
    nnoremap <buffer><silent> a <Nop>
enddef

