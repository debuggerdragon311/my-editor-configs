# -------------------------------------------------------------------------
# 6. Distinct Dynamic Statusline Engine (Unified Across Windows)
# -------------------------------------------------------------------------
def GitBranch(): string
    if exists('b:git_branch')
        return b:git_branch
    endif
    var branch = ''
    if executable('git') && expand('%:p') !=# ''
        var dir = expand('%:p:h')
        var res = system('git -C ' .. shellescape(dir) .. ' rev-parse --abbrev-ref HEAD 2>/dev/null')
        if v:shell_error == 0
            branch = substitute(res, '\n', '', '')
        endif
    endif
    b:git_branch = branch
    return branch
enddef

augroup GitBranchCache
    autocmd!
    autocmd BufEnter,BufWritePost * unlet! b:git_branch
augroup END

def StatusModeText(): string
    var m = mode()
    var modes = {
        'n': ' NORMAL ',
        'i': ' INSERT ',
        'v': ' VISUAL ',
        'V': ' V-LINE ',
        "\<C-v>": ' V-BLOCK ',
        'R': ' REPLACE ',
        'c': ' COMMAND ',
        't': ' TERMINAL '
    }
    return get(modes, m, ' NORMAL ')
enddef

def UpdateStatusHighlights(): void
    var m = mode()
    var mode_color = '#51afef'
    var mode_text  = '#1b2229'
    var mode_cterm = '75'
    var text_cterm = '234'

    if m ==# 'i'
        mode_color = '#98be65'
        mode_cterm = '114'
    elseif m ==# 'v' || m ==# 'V' || m ==# "\<C-v>"
        mode_color = '#c678dd'
        mode_cterm = '176'
    elseif m ==# 'R'
        mode_color = '#ff6c6b'
        mode_cterm = '203'
    elseif m ==# 'c'
        mode_color = '#ECBE7B'
        mode_cterm = '222'
    endif

    hi StatusLine   guifg=#bbc2cf guibg=#3E4556 gui=NONE ctermfg=251 ctermbg=239 cterm=NONE
    hi StatusLineNC guifg=#5B6268 guibg=#2E323C gui=NONE ctermfg=241 ctermbg=237 cterm=NONE
    hi SL_Empty     guifg=#bbc2cf guibg=#21242b gui=NONE ctermfg=251 ctermbg=235 cterm=NONE

    execute $'hi SL_Mode guifg={mode_text} guibg={mode_color} gui=bold ctermfg={text_cterm} ctermbg={mode_cterm} cterm=bold'
    execute $'hi SL_Pos  guifg={mode_text} guibg={mode_color} gui=bold ctermfg={text_cterm} ctermbg={mode_cterm} cterm=bold'
    hi SL_Git       guifg=#bbc2cf guibg=#3E4556 gui=bold ctermfg=251 ctermbg=239 cterm=bold
    hi SL_File      guifg=#bbc2cf guibg=#2E323C gui=bold ctermfg=251 ctermbg=237 cterm=bold
    hi SL_Mod       guifg=#ECBE7B guibg=#2E323C gui=bold ctermfg=222 ctermbg=237 cterm=bold
    hi SL_RO        guifg=#ff6c6b guibg=#2E323C gui=bold ctermfg=203 ctermbg=237 cterm=bold
    hi SL_Info      guifg=#bbc2cf guibg=#3E4556 gui=NONE ctermfg=251 ctermbg=239 cterm=NONE

    execute $'hi SL_ModeToGit   guifg={mode_color} guibg=#3E4556 gui=NONE ctermfg={mode_cterm} ctermbg=239'
    execute $'hi SL_ModeToFile  guifg={mode_color} guibg=#2E323C gui=NONE ctermfg={mode_cterm} ctermbg=237'
    hi SL_GitToFile   guifg=#3E4556 guibg=#2E323C gui=NONE ctermfg=239 ctermbg=237
    hi SL_FileToEmpty guifg=#2E323C guibg=#21242b gui=NONE ctermfg=237 ctermbg=235
    hi SL_EmptyToInfo guifg=#3E4556 guibg=#21242b gui=NONE ctermfg=239 ctermbg=235
    execute $'hi SL_InfoToPos   guifg={mode_color} guibg=#3E4556 gui=NONE ctermfg={mode_cterm} ctermbg=239'
enddef

def g:RenderStatusLine(): string
    UpdateStatusHighlights()
    var branch = GitBranch()
    var s = ''

    s ..= '%#SL_Mode#' .. StatusModeText()
    if branch !=# ''
        s ..= '%#SL_ModeToGit#%#SL_Git#  ' .. branch .. ' %#SL_GitToFile#'
    else
        s ..= '%#SL_ModeToFile#'
    endif

    s ..= '%#SL_File# %f '
    s ..= '%#SL_Mod#%{&modified ? "● " : ""}'
    s ..= '%#SL_RO#%{&readonly ? "[RO] " : ""}'
    s ..= '%#SL_FileToEmpty#'
    s ..= '%#SL_Empty#%='

    var ft = empty(&filetype) ? 'none' : &filetype
    var enc = empty(&fileencoding) ? &encoding : &fileencoding
    var fmt = &fileformat
    s ..= '%#SL_EmptyToInfo#%#SL_Info# ' .. ft .. '  ' .. enc .. ' [' .. fmt .. '] '
    s ..= '%#SL_InfoToPos#%#SL_Pos# Ln %l, Col %c  %p%% '

    return s
enddef

set statusline=%!g:RenderStatusLine()

augroup StatuslineColors
    autocmd!
    autocmd ModeChanged,CursorMoved,CursorMovedI,BufEnter,WinEnter * UpdateStatusHighlights()
    autocmd FileType nerdtree setlocal statusline=%#SL_Empty#
augroup END

# -------------------------------------------------------------------------
# 7. Tabline Engine (Matching 3-Shade Gradient & Clean Icons)
# -------------------------------------------------------------------------
def g:RenderTabLine(): string
    var s = ''
    var total_tabs = tabpagenr('$')
    var curr_tab = tabpagenr()

    for i in range(total_tabs)
        var tabnr = i + 1
        var buflist = tabpagebuflist(tabnr)
        var bufnr = buflist[tabpagewinnr(tabnr) - 1]
        var bname = bufname(bufnr)
        var is_mod = getbufvar(bufnr, '&mod')
        var label = (bname != '' ? fnamemodify(bname, ':t') : '[No Name]')

        if tabnr == curr_tab
            s ..= '%#TabLineSel# ' .. tabnr .. '  ' .. label .. (is_mod ? ' %#TabLineMod#●%#TabLineSel# ' : ' ')
            if tabnr < total_tabs
                s ..= '%#TabSelToInact#'
            else
                s ..= '%#TabSelToFill#'
            endif
        else
            s ..= '%#TabLine# ' .. tabnr .. '  ' .. label .. (is_mod ? ' ● ' : ' ')
            if tabnr + 1 == curr_tab
                s ..= '%#TabInactToSel#'
            else
                s ..= '%#TabInactToFill#'
            endif
        endif
    endfor

    s ..= '%#TabLineFill#%='

    var cwd = fnamemodify(getcwd(), ':t')
    var cwd_display = (cwd != '' ? cwd : 'root')
    var buf_count = len(filter(range(1, bufnr('$')), (_, v) => buflisted(v)))
    var time = strftime('%H:%M')

    s ..= '%#TabR_Trans1#%#TabR_Sec1#  ' .. cwd_display .. '  󰓩 ' .. buf_count .. ' '
    s ..= '%#TabR_Trans2#%#TabR_Sec2#  ' .. time .. ' '

    return s
enddef

set tabline=%!g:RenderTabLine()

