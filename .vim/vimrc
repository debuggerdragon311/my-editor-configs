def TrimWhitespace(): void
    var save_cursor = getpos('.')
    var old_query = getreg('/')
    silent! keeppatterns :%s/\s\+$//e
    setpos('.', save_cursor)
    setreg('/', old_query)
enddef

augroup WhiteSpaceClean
    autocmd!
    autocmd BufWritePre *.zig,*.c,*.cpp,*.rs,*.go,*.py,*.js,*.ts,*.sh TrimWhitespace()
augroup END

