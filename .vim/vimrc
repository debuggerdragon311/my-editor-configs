def CloseNERDTreeIfLast(): void
    if tabpagenr('$') == 1 && winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree()
        feedkeys(":quit\<CR>:\<BS>")
    endif
enddef

def PreventNERDTreeOpen(): void
    if winnr() == winnr('h') && bufname('#') =~ 'NERD_tree_\d\+' && bufname('%') !~ 'NERD_tree_\d\+' && winnr('$') > 1
        var curbuf = bufnr()
        buffer %%
        wincmd w
        execute $'buffer {curbuf}'
    endif
enddef

augroup NERDTreeAutoRules
    autocmd!
    autocmd BufEnter * CloseNERDTreeIfLast()
    autocmd BufEnter * PreventNERDTreeOpen()
augroup END

