#!/usr/bin/env bash
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. Point to your portable runtime folder
export VIMRUNTIME="$HERE/runtime"

# 2. Launch with zero-trace flags:
#    -u "$HERE/vimrc" -> Uses your portable config (ignores host ~/.vimrc)
#    -i NONE          -> Disables saving history/marks (never writes ~/.viminfo to the host)
exec "$HERE/vim" \
    -u "$HERE/vimrc" \
    -i NONE \
    "$@"
